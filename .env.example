# =============================================================
# MODELO do arquivo .env (sem chaves reais!)
# =============================================================
# Para testar no seu computador:
#   1. Copie este arquivo e renomeie a cópia para .env
#   2. Troque SUA_CHAVE_AQUI pela sua chave de verdade
#   3. Nunca envie o .env para o GitHub (o .gitignore já impede)
#
# Não é preciso ter as três chaves: o assistente usa as que existirem,
# na ordem definida no config.yml.
#
# No Hugging Face, essas mesmas chaves vão em:
#   Space -> Settings -> Variables and secrets -> New secret
# =============================================================

OPENROUTER_API_KEY=SUA_CHAVE_AQUI
ANTHROPIC_API_KEY=SUA_CHAVE_AQUI
OPENAI_API_KEY=SUA_CHAVE_AQUI
